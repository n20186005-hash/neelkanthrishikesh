---
import Base from '../layouts/Base.astro';
import { absUrl } from '../data/site';
import { labelForLink, topicAlternates, type Topic } from '../data/topics';
import type { Locale } from '../lib/ui';

type Props = { topic: Topic; locale: Locale };
const { topic, locale } = Astro.props;
const content = locale === 'en' ? topic.en : topic.hi;
const path = locale === 'hi' ? `/${topic.slug}/` : `/en/${topic.slug}/`;
const home = locale === 'hi' ? '/' : '/en/';
const alternates = topicAlternates(topic.slug);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': absUrl(`${path}#faq`),
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': absUrl(`${path}#breadcrumb`),
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: locale === 'en' ? 'Home' : 'मुखपृष्ठ', item: absUrl(home) },
    { '@type': 'ListItem', position: 2, name: content.h1, item: absUrl(path) }
  ]
};
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': absUrl(`${path}#webpage`),
  url: absUrl(path),
  name: content.h1,
  inLanguage: locale === 'en' ? 'en' : 'hi-IN',
  isPartOf: { '@type': 'WebSite', '@id': absUrl('/#website') },
  about: { '@type': 'TouristAttraction', '@id': absUrl('/#attraction') },
  breadcrumb: { '@id': absUrl(`${path}#breadcrumb`) }
};

const relatedUrls = topic.related
  .map((slug) => ({ slug, label: labelForLink(slug, locale) }))
  .filter((r) => r.label !== r.slug);
---
<Base
  title={locale === 'en' ? `${content.h1} | Neelkanth Mahadev Temple Guide` : `${content.h1} | नीलकंठ महादेव यात्री मार्गदर्शिका`}
  description={content.lead}
  path={path}
  locale={locale}
  alternates={alternates}
>
  {[faqLd, breadcrumbLd, webPageLd].map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <article class="section bg-deep text-white">
    <div class="container">
      <p class="eyebrow !text-[#ffc477]">{content.kicker}</p>
      <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl">{content.h1}</h1>
      <p class="mt-4 max-w-3xl text-lg text-white/80">{content.lead}</p>
      {
        content.facts && (
          <dl class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-4">
            {content.facts.map(([k, v]) => (
              <div>
                <dt class="text-sm text-white/70">{k}</dt>
                <dd class="text-xl font-bold">{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </article>

  <div class="section">
    <div class="container max-w-4xl">
      {content.sections.map((s) => (
        <section class="prose mt-10 max-w-none">
          <h2>{s.heading}</h2>
          {s.paragraphs?.map((p) => <p>{p}</p>)}
          {s.bullets && (
            <ul>
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.callout && (
            <p class="mt-3 rounded-2xl bg-[#ede5d6] p-4 text-sm text-[#586056]">{s.callout}</p>
          )}
        </section>
      ))}

      <section class="mt-12">
        <h2 class="text-3xl font-black">{locale === 'en' ? 'Common questions' : 'सामान्य सवाल'}</h2>
        <div class="mt-5 grid gap-4">
          {content.faqs.map((f) => (
            <details class="card p-5">
              <summary class="cursor-pointer font-black">{f.q}</summary>
              <p class="mt-3 text-sm">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      {
        relatedUrls.length > 0 && (
          <section class="mt-12">
            <h2 class="text-3xl font-black">{locale === 'en' ? 'Related guides' : 'संबंधित मार्गदर्शिकाएँ'}</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {relatedUrls.map((r) => (
                <a class="card p-5 font-bold text-[#9a4d06] underline decoration-[#d97706]/50 underline-offset-4" href={locale === 'hi' ? `/${r.slug}/` : `/en/${r.slug}/`}>
                  {r.label}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <p class="mt-12 rounded-2xl bg-[#ede5d6] p-5 text-sm text-[#586056]">
        {locale === 'en'
          ? `Independent visitor guide. Last reviewed ${content.updated}. Verify fresh timings, fares and road status with local sources before travel.`
          : `स्वतंत्र यात्री मार्गदर्शिका। अंतिम समीक्षा ${content.updated}। यात्रा से पहले ताज़ा समय, किराया व सड़क-स्थिति स्थानीय स्रोतों से जाँचें।`}
      </p>
    </div>
  </div>
</Base>
