const rows=[['गर्म दिन','पानी, टोपी और विश्राम की योजना रखें; निकलने से पहले ताज़ा पूर्वानुमान देखें।'],['बारिश या कोहरा','सड़क और पैदल मार्ग की स्थानीय स्थिति पूछें; बंदी या चेतावनी को प्राथमिकता दें।'],['पर्व और तीर्थ यात्रा','प्रवेश, यातायात नियंत्रण और वापसी के साधन पहले जाँचें; पुराने समय को निश्चित न मानें।'],['ठंडी सुबह या शाम','पूर्वानुमान के अनुसार अतिरिक्त कपड़े रखें और अँधेरे से पहले वापसी पर विचार करें।']];
