---
import { COUNTRY_NAME, SOURCES, STATE_PROVINCE } from '../data/site';
import type { Locale } from '../lib/ui';
const { locale = 'hi' as Locale } = Astro.props;
const L = locale === 'en'
  ? {
      id: 'sources',
      eyebrow: 'Sources & references',
      h2: 'Sources, verification date and their limits',
      body: 'Verified: 20 October 2026. This is an independent tourist guide. The district page’s own last update is 6 April 2018; it does not certify today’s open route. Public and official sources used to cross-check the facts are listed below; verifying fresh information from these sources before any travel decision is useful.',
      portalLabel: `${COUNTRY_NAME} / ${STATE_PROVINCE} Official Tourism Portal`
    }
  : {
      id: 'स्रोत',
      eyebrow: 'स्रोत व संदर्भ (Sources)',
      h2: 'स्रोत, जाँच की तारीख और उनकी सीमाएँ',
      body: 'जाँच: 20 अक्टूबर 2026। यह स्वतंत्र पर्यटक मार्गदर्शिका है। जिला पृष्ठ का अपना अंतिम अद्यतन 6 अप्रैल 2018 है; इससे आज का खुला मार्ग प्रमाणित नहीं होता। नीचे सार्वजनिक और आधिकारिक स्रोत दिए गए हैं जिनसे तथ्यों का मिलान किया गया; किसी भी यात्रा निर्णय से पहले इन स्रोतों से ताज़ा जानकारी सत्यापित करना उपयोगी है।',
      portalLabel: `${COUNTRY_NAME} / ${STATE_PROVINCE} आधिकारिक पर्यटन पोर्टल`
    };
---
<section id={L.id} class="section bg-[#ede5d6]">
  <div class="container">
    <p class="eyebrow">{L.eyebrow}</p>
    <h2 class="mt-3 text-4xl font-black">{L.h2}</h2>
    <p class="mt-3 max-w-3xl text-[#586056]">{L.body}</p>
    <ul class="mt-7 grid gap-4 md:grid-cols-2">
      {
        SOURCES.map((source) => (
          <li class="card p-5">
            <a
              class="font-bold text-[#9a4d06] underline decoration-[#d97706]/50 underline-offset-4"
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {locale === 'en' ? source.nameEn : source.name}
            </a>
            <p class="mt-2 text-sm text-[#596158]">{locale === 'en' ? source.noteEn : source.note}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-[#586056]">
      For official updates and regional tourism information, visit
      <a
        class="mx-1 font-semibold text-[#9a4d06] underline underline-offset-4"
        href={SOURCES[0].url}
        target="_blank"
        rel="noopener noreferrer">{L.portalLabel}</a
      >.
    </p>
  </div>
</section>
