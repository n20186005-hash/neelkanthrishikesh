---
import { ATTRACTION_SHORT_NAME, CITY_NAME_HI } from '../data/site';
const audiences = [
  {
    icon: '👨‍👩‍👧',
    title: 'परिवार / बच्चों के साथ',
    body: [
      'सुबह जल्दी निकलें ताकि दोपहर की गर्मी व भीड़ से बचें।',
      'साथ में पानी, हल्का स्नैक, टोपी और प्राथमिक दवा रखें।',
      'मंदिर परिसर में धीमी गति व सुरक्षित दूरी बनाए रखें; बच्चों को भीड़ से दूर रखें।'
    ]
  },
  {
    icon: '📷',
    title: 'फोटोग्राफी / प्रकृति',
    body: [
      'सुबह की कोमल रोशनी और बादल क्षेत्र के लिए सबसे उपयुक्त हैं।',
      'तीन घाटियों, वनाच्छादित रास्ते और जलधाराओं को शामिल करें।',
      'ड्रोन व प्रतिबंधित क्षेत्र की अनुमति स्थानीय नियम से जाँचें।'
    ]
  },
  {
    icon: '♿',
    title: 'कम शारीरिक प्रयास / सुगम्य',
    body: [
      'सीधे सड़क मार्ग (टैक्सी/निजी वाहन) से पहुँचें; पैदल ट्रेक से बचें।',
      'परिसर में ढलान/सीढ़ियों के लिए अतिरिक्त समय रखें और सहायता लें।',
      'व्हीलचेयर-अनुकूल मानकर न चलें; स्थानीय व्यवस्था पूछें।'
    ]
  }
];
const plans = [
  {
    dur: 'अर्ध-दिवस (≈4–5 घंटे)',
    steps: [
      'ऋषिकेश से टैक्सी/साझा वाहन से नीलकंठ प्रस्थान (सुबह)।',
      '≈32 किमी पहाड़ी मार्ग, रास्ते में बाज़ार/चाय स्टॉप।',
      'दर्शन, परिसर भ्रमण व तस्वीरें (1–3 घंटे)।',
      'दोपहर से पहले वापसी और ऋषिकेश के घाट/आश्रम।'
    ]
  },
  {
    dur: 'पूर्ण-दिवस (≈8–10 घंटे)',
    steps: [
      'सुबह नीलकंठ दर्शन व वन-परिसर।',
      'दोपहर भोजन/विश्राम (सामान्य शाकाहारी विकल्प)।',
      'वापसी में ऋषिकेश: लक्ष्मण झूला/राम झूला, त्रिवेणी घाट, गंगा आरती।',
      'शाम की आरती के बाद वापसी — पूरा तीर्थ-दिवस।'
    ]
  }
];
---
<section class="section bg-[#ede5d6]">
  <div class="container">
    <p class="eyebrow">यात्रा योजना के प्रकार</p>
    <h2 class="mt-3 text-4xl font-black">{ATTRACTION_SHORT_NAME} — आपके अनुसार यात्रा योजना</h2>
    <p class="mt-3 max-w-3xl text-[#586056]">
      एक ही स्थान अलग-अलग यात्रियों के लिए अलग अनुभव होता है। नीचे तीन सामान्य यात्री-समूहों और दो सामान्य मार्गों का संतुलित विवरण है।
    </p>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      {audiences.map((a) => (
        <div class="card p-6">
          <span class="text-3xl">{a.icon}</span>
          <h3 class="mt-3 font-black">{a.title}</h3>
          <ul class="mt-3 space-y-2 text-sm text-[#596158]">
            {a.body.map((b) => (
              <li class="flex gap-2"><span>›</span><span>{b}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {plans.map((p) => (
        <div class="card p-6">
          <h3 class="font-black">{p.dur}</h3>
          <ol class="mt-3 space-y-2 text-sm text-[#596158] list-decimal pl-5">
            {p.steps.map((s) => (
              <li>{s}</li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
