---
import { getWeather, wmo, compass, buildAdvice } from '../lib/weather';
const w = await getWeather();
const cur = w?.current;
const info = cur ? wmo(cur.code) : null;
const advice = w ? buildAdvice(w) : null;
const today = w?.days[0];
---
<section id="मौसम" class="section bg-[#ede5d6]">
  <div class="container">
    <p class="eyebrow">मौसम व यात्रा की तैयारी</p>
    <h2 class="mt-3 text-4xl font-black">ऋषिकेश/नीलकंठ क्षेत्र का मौसम — आज और आने वाले दिन</h2>
    {
      w && cur && info ? (
        <>
          <div class="mt-8 grid gap-6 lg:grid-cols-[1.05fr_1.95fr]">
            <div class="card p-7">
              <p class="text-sm text-[#586056]">वर्तमान स्थिति</p>
              <div class="mt-2 flex items-end gap-3">
                <span class="text-6xl">{info.icon}</span>
                <span class="text-5xl font-black">{cur.temp}°</span>
              </div>
              <p class="mt-2 text-lg font-bold">{info.hi}</p>
              <p class="mt-1 text-sm text-[#586056]">
                हवा में यह महसूस होगा: {cur.apparent}° · हवा {cur.windSpeed} किमी/घंटा ({compass(cur.windDir)})
              </p>
              <p class="mt-1 text-sm text-[#586056]">
                वर्षा संभावना {today?.precipProb ?? 0}% · पराबैंगनी (UV) {today?.uvMax ?? '—'}
              </p>
              <p class="mt-1 text-xs text-[#6b6357]">
                {cur.time ? 'अद्यतन: ' + cur.time.slice(11, 16) + ' (भारतीय समय)' : ''}
              </p>
            </div>
            <div class="card p-7">
              <p class="text-sm text-[#586056]">आने वाले 7 दिन</p>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
                {w.days.map((d) => {
                  const di = wmo(d.code);
                  return (
                    <div class="rounded-xl border border-black/5 bg-white/70 p-3 text-center">
                      <p class="text-xs font-bold text-[#7a6a4f]">{d.weekday}</p>
                      <p class="my-1 text-2xl">{di.icon}</p>
                      <p class="text-sm font-black">{d.tMax}°</p>
                      <p class="text-xs text-[#6b6357]">{d.tMin}°</p>
                      <p class="mt-1 text-[11px] text-[#7a6a4f]">बारिश {d.precipProb}%</p>
                      {d.uvMax > 0 && <p class="text-[11px] text-[#7a6a4f]">UV {d.uvMax}</p>}
                    </div>
                  );
                })}
              </div>
              <p class="mt-4 text-xs text-[#6b6357]">
                सूर्योदय/अस्त: {w.days[0]?.sunrise}–{w.days[0]?.sunset} (भारतीय समय) · पहाड़ी क्षेत्र में मौसम तेज़ी से बदल सकता है; यात्रा से पहले ताज़ा जानकारी देखें।
              </p>
            </div>
          </div>

          {advice && advice.risk.length > 0 && (
            <div class="mt-6 rounded-2xl border border-red-300 bg-red-50 p-5">
              <p class="font-black text-red-800">⚠️ सुरक्षा सावधानी (मौसम के आधार पर)</p>
              <ul class="mt-2 space-y-1 text-sm text-red-900">
                {advice.risk.map((r) => <li class="flex gap-2"><span>•</span><span>{r}</span></li>)}
              </ul>
            </div>
          )}

          {advice && (advice.outfit.length + advice.activity.length + advice.items.length) > 0 && (
            <div class="mt-6 grid gap-5 md:grid-cols-3">
              {advice.outfit.length > 0 && (
                <div class="rounded-2xl border border-black/5 bg-white/80 p-6">
                  <p class="font-black">👕 यात्रा पहनावा</p>
                  <ul class="mt-3 space-y-2 text-sm text-[#596158]">
                    {advice.outfit.map((s) => <li class="flex gap-2"><span>✓</span><span>{s}</span></li>)}
                  </ul>
                </div>
              )}
              {advice.activity.length > 0 && (
                <div class="rounded-2xl border border-black/5 bg-white/80 p-6">
                  <p class="font-black">🧭 घूमने की योजना</p>
                  <ul class="mt-3 space-y-2 text-sm text-[#596158]">
                    {advice.activity.map((s) => <li class="flex gap-2"><span>✓</span><span>{s}</span></li>)}
                  </ul>
                </div>
              )}
              {advice.items.length > 0 && (
                <div class="rounded-2xl border border-black/5 bg-white/80 p-6">
                  <p class="font-black">🎒 साथ रखें</p>
                  <ul class="mt-3 space-y-2 text-sm text-[#596158]">
                    {advice.items.map((s) => <li class="flex gap-2"><span>✓</span><span>{s}</span></li>)}
                  </ul>
                </div>
              )}
            </div>
          )}
        </>
      ) : (
        <div class="mt-8 card p-7 text-sm text-[#586056]">
          इस समय मौसम जानकारी अस्थायी रूप से उपलब्ध नहीं है। पहाड़ी क्षेत्र में मौसम बदलता रहता है, इसलिए यात्रा से पहले स्थानीय संदर्भ देखें।
        </div>
      )
    }
  </div>
</section>
