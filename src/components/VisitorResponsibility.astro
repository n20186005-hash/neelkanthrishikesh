---
import { ATTRACTION_SHORT_NAME } from '../data/site';
const items = [
  {
    icon: '🌿',
    title: 'पारिस्थितिकी व जलधाराएँ',
    body: 'पानी और वन क्षेत्र में कचरा न छोड़ें। किसी जलधारा या खुले रास्ते तक पहुँच को अनुमति प्राप्त न मानें।'
  },
  {
    icon: '🐾',
    title: 'वन क्षेत्र में जिम्मेदारी',
    body: 'वन में शोर न करें, खाना खुला न छोड़ें और कोई वन्यजीव दिखे तो दूरी रखें। स्थानीय अनुमति और चेतावनी का पालन करें।'
  },
  {
    icon: '🧘',
    title: 'धार्मिक व सांस्कृतिक सम्मान',
    body: 'मंदिर एक सक्रिय पूजा-स्थल है। जूते बाहर उतारें, शांति बनाए रखें, फोटोग्राफी के लिए स्थानीय नियम मानें और पूजा-व्यवस्था का सम्मान करें।'
  },
  {
    icon: '♻️',
    title: 'शून्य-कचरा (Leave No Trace)',
    body: 'प्लास्टिक, प्रसाद-लेप व कचरा वापस ले जाएँ; पहाड़ी व वन क्षेत्र नाज़ुक हैं। पुन: उपयोग बोतल व टिश्यू साथ रखें।'
  },
  {
    icon: '🚦',
    title: 'सुरक्षा व मौसम',
    body: 'पहाड़ी सड़कों पर गति व मोड़, बारिश में फिसलन और भूस्खलन जोखिम रहता है। मौसम चेतावनी, ईंधन/चार्ज और वापसी का समय पहले तय करें।'
  },
  {
    icon: '🤝',
    title: 'स्थानीय समुदाय',
    body: 'यात्रा से क्षेत्र की अर्थव्यवस्था व स्वच्छता प्रभावित होती है। व्यवस्था का सम्मान करें, अनावश्यक प्लास्टिक से बचें और स्थानीय सलाह पर चलें।'
  }
];
---
<section class="section">
  <div class="container">
    <p class="eyebrow">जिम्मेदार यात्रा</p>
    <h2 class="mt-3 text-4xl font-black">{ATTRACTION_SHORT_NAME} — पर्यावरण, सुरक्षा और आपकी जिम्मेदारी</h2>
    <p class="mt-3 max-w-3xl text-[#586056]">
      नीचे सामान्य जिम्मेदार यात्रा सुझाव हैं। ये स्थानीय प्रशासन या मंदिर प्रबंधन के निर्देशों का स्थान नहीं लेते।
    </p>
    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((it) => (
        <div class="rounded-2xl border border-black/5 bg-white/70 p-6">
          <span class="text-2xl">{it.icon}</span>
          <h3 class="mt-3 font-black">{it.title}</h3>
          <p class="mt-2 text-sm text-[#596158]">{it.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 rounded-2xl border border-amber-800/20 bg-amber-50 p-5 text-sm text-amber-950">
      <b>संक्षेप:</b> धार्मिक परंपराओं का सम्मान करें, कतार न तोड़ें, प्लास्टिक/कचरा न फैलाएँ, वन क्षेत्र में शोर न करें और किसी भी मौसम/सड़क चेतावनी को प्राथमिकता दें।
    </div>
  </div>
</section>
