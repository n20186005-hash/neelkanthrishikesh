---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { HERO_IMAGE_ALT, HERO_IMAGE_ALT_EN, SITE_NAME, SITE_NAME_EN, absUrl } from '../data/site';
import { UI, counterpartPath, type Locale } from '../lib/ui';

type Props = {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  locale?: Locale;
  alternates?: { lang: string; href: string }[];
};

const {
  title,
  description,
  path = '/',
  image = '/images/og-cover.jpg',
  noindex = false,
  locale = 'hi',
  imageAlt = locale === 'en' ? HERO_IMAGE_ALT_EN : HERO_IMAGE_ALT,
  alternates
} = Astro.props;

const base = Astro.site;
const canonical = base ? new URL(path, base).toString() : undefined;
const ogImage = base ? new URL(image, base).toString() : image;
const siteName = locale === 'en' ? SITE_NAME_EN : SITE_NAME;

const ui = UI[locale];
const otherPath = counterpartPath(path, locale);
const switchHref = absUrl(otherPath);

// hreflang वैकल्पिक: prop दिया गया तो उसे ही उपयोग करें, अन्यथा path से बनाएँ
const hreflangs = alternates ?? [
  { lang: 'hi-IN', href: absUrl(locale === 'hi' ? path : `/${path}`) },
  { lang: 'en', href: absUrl(locale === 'hi' ? `/en${path}` : path) },
  { lang: 'x-default', href: absUrl(path) }
];
---
<!doctype html>
<html lang={ui.htmlLang} dir={ui.dir}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="preconnect" href="https://www.google.com"/>
  <link rel="dns-prefetch" href="https://www.google.com"/>
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex, follow"/>}
  <meta name="description" content={description}/>
  {canonical && <link rel="canonical" href={canonical}/>}
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  {canonical && <meta property="og:url" content={canonical}/>}
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:alt" content={imageAlt}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:site_name" content={siteName}/>
  <meta property="og:locale" content={ui.ogLocale}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  <meta name="twitter:image:alt" content={imageAlt}/>
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32"/>
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16"/>
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"/>
  <link rel="manifest" href="/site.webmanifest"/>
  <meta name="theme-color" content="#16231d"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
  <meta name="apple-mobile-web-app-title" content={siteName}/>
  {hreflangs.map((a) => <link rel="alternate" hreflang={a.lang} href={absUrl(a.href)} />)}
  <script is:inline src="/consent.js" defer></script>
  <script is:inline src="/site.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">{ui.skip}</a>
  <header class="sticky top-0 z-40 border-b border-black/5 bg-[#f7f2e8]/92 backdrop-blur">
    <div class="container flex min-h-18 items-center justify-between gap-6">
      <Brand compact locale={locale}/>
      <nav class="hidden md:flex gap-5 text-sm font-semibold text-[#3f493f]" aria-label="primary">
        {ui.nav.map((n) => <a href={absUrl(n.href)}>{n.label}</a>)}
      </nav>
      <div class="flex items-center gap-3">
        <a href={switchHref} class="rounded-full border border-[#315b46]/30 px-3 py-1.5 text-xs font-bold text-[#315b46]">{ui.languageName}</a>
        <a href={absUrl(ui.ctaHref)} class="rounded-full bg-deep px-4 py-2 text-sm font-bold text-white">{ui.cta}</a>
      </div>
      <details class="mobile-menu md:hidden">
        <summary aria-label="menu">{locale === 'en' ? 'Menu' : 'मेनू'}</summary>
        <nav aria-label="mobile">
          {ui.nav.map((n) => <a href={absUrl(n.href)}>{n.label}</a>)}
          <a href={switchHref}>{ui.languageName}</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="main"><slot/></main>
  <footer class="bg-deep py-12 text-[#f4efe5]">
    <div class="container grid gap-8 md:grid-cols-[1.1fr_.9fr]">
      <div>
        <Brand locale={locale}/>
        <p class="mt-5 max-w-2xl text-sm text-white/70">{ui.footerTagline}</p>
        <p class="mt-3 text-sm text-white/70">{ui.footerNote}</p>
        <p class="mt-5 text-sm">© 2026 {siteName}.</p>
      </div>
      <div class="md:text-right">
        <p class="text-sm font-bold text-white/60">{locale === 'en' ? 'Legal' : 'कानूनी जानकारी'}</p>
        <div class="mt-4 flex flex-col gap-2 md:items-end">
          {ui.footerLegal.map((l) => <a href={absUrl(l.href)}>{l.label}</a>)}
        </div>
        <p class="mt-6 text-xs text-white/55">{ui.footerDisclaimer}</p>
      </div>
    </div>
  </footer>
</body>
</html>
