---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { HERO_IMAGE_ALT, SITE_NAME, SITE_NAME_EN, absUrl } from '../data/site';
const {
  title,
  description,
  path = '/',
  image = '/images/og-cover.jpg',
  imageAlt = HERO_IMAGE_ALT,
  noindex = false
} = Astro.props;
const base = Astro.site;
const canonical = base ? new URL(path, base).toString() : undefined;
const ogImage = base ? new URL(image, base).toString() : image;
const siteName = `${SITE_NAME} (${SITE_NAME_EN})`;
---
<!doctype html><html lang="hi-IN"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><link rel="preconnect" href="https://www.google.com"/><link rel="dns-prefetch" href="https://www.google.com"/>
<title>{title}</title>{noindex && <meta name="robots" content="noindex, follow"/>}<meta name="description" content={description}/>
{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical && <meta property="og:url" content={canonical}/>}<meta property="og:image" content={ogImage}/><meta property="og:image:alt" content={imageAlt}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:site_name" content={siteName}/><meta property="og:locale" content="hi_IN"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><meta name="twitter:image:alt" content={imageAlt}/>
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/icons/favicon-32.png" sizes="32x32"/><link rel="icon" href="/icons/favicon-16.png" sizes="16x16"/><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"/>
<link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#16231d"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="default"/><meta name="apple-mobile-web-app-title" content="नीलकंठ मार्गदर्शिका"/><link rel="alternate" href={absUrl(path)} hreflang="hi-IN"/><link rel="alternate" href={absUrl(path)} hreflang="x-default"/>
<script is:inline src="/consent.js" defer></script>
<script is:inline src="/site.js" defer></script>
</head><body><a class="skip" href="#main">मुख्य सामग्री पर जाएँ</a>
<header class="sticky top-0 z-40 border-b border-black/5 bg-[#f7f2e8]/92 backdrop-blur"><div class="container flex min-h-18 items-center justify-between gap-6"><Brand compact/><nav class="hidden md:flex gap-5 text-sm font-semibold text-[#3f493f]"><a href="/#परिचय">परिचय</a><a href="/#इतिहास">इतिहास</a><a href="/#यात्रा">कैसे पहुँचें</a><a href="/#सुविधाएँ">सुविधाएँ</a><a href="/#मानचित्र">मानचित्र</a><a href="/#मौसम">मौसम</a><a href="/#सवाल">सवाल</a><a href="/#स्रोत">स्रोत</a></nav><details class="mobile-menu md:hidden"><summary aria-label="नेविगेशन मेनू">मेनू</summary><nav aria-label="मोबाइल नेविगेशन"><a href="/#परिचय">परिचय</a><a href="/#इतिहास">कथा</a><a href="/#यात्रा">मार्ग और दूरी</a><a href="/#सुविधाएँ">सुविधाएँ</a><a href="/#मानचित्र">मानचित्र</a><a href="/#मौसम">मौसम</a><a href="/#सवाल">सवाल</a><a href="/#स्रोत">स्रोत</a></nav></details><a href="/#यात्रा" class="rounded-full bg-deep px-4 py-2 text-sm font-bold text-white">यात्रा योजना</a></div></header>
<main id="main"><slot/></main>
<footer class="bg-deep py-12 text-[#f4efe5]"><div class="container grid gap-8 md:grid-cols-[1.1fr_.9fr]"><div><Brand/><p class="mt-5 max-w-2xl text-sm text-white/70">यह वेबसाइट एक स्वतंत्र, गैर-लाभकारी पर्यटक सूचना मार्गदर्शिका परियोजना है और किसी सरकारी संस्था या आधिकारिक संगठन से संबद्ध नहीं है।</p><p class="mt-3 text-sm text-white/70">मंदिर के परिचय और पुरानी मार्ग-दूरी का जिला प्रशासन से मिलान किया गया है। दैनिक समय और सड़क स्थिति स्थानीय सूचना से फिर जाँचें।</p><p class="mt-3 text-sm text-white/70">मुख्य और साझा-कार्ड का ऐतिहासिक चित्र: Rahuldewangan, 23 मार्च 2010, Wikimedia Commons पर सार्वजनिक डोमेन।</p><p class="mt-5 text-sm">© 2026 नीलकंठ महादेव यात्री मार्गदर्शिका। सर्वाधिकार सुरक्षित।</p></div><div class="md:text-right"><p class="text-sm font-bold text-white/60">कानूनी जानकारी</p><div class="mt-4 flex flex-col gap-2 md:items-end"><a href="/privacy/">गोपनीयता नीति</a><a href="/terms/">सेवा की शर्तें</a><a href="/cookies/">कुकी सेटिंग</a></div><p class="mt-6 text-xs text-white/55">महत्वपूर्ण यात्रा निर्णय लेने से पहले संबंधित आधिकारिक स्रोत से ताज़ा जानकारी सत्यापित करें।</p></div></div></footer>
</body></html>
