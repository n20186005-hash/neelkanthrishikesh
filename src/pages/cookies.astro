---
import Base from '../layouts/Base.astro';
---
<Base title="कुकी सेटिंग | नीलकंठ महादेव यात्री मार्गदर्शिका" description="कुकी प्राथमिकताएँ देखें और बदलें।" path="/cookies/">
<section class="section"><div class="container max-w-4xl"><p class="eyebrow">नियंत्रण</p><h1 class="mt-3 text-4xl font-black">कुकी सेटिंग</h1><p class="mt-3 text-[#596158]"><strong>अंतिम अद्यतन: अगस्त 2026</strong></p><p class="mt-5 text-[#596158]">हम कुकी और स्थानीय स्टोरेज जैसी तकनीकों का सीमित उपयोग करते हैं। आवश्यक सेटिंग साइट की मूल कार्यक्षमता के लिए होती है; विश्लेषण आपकी सहमति से सक्रिय होता है। यह स्वतंत्र गैर-लाभकारी साइट वर्तमान में निजीकरण-आधारित विज्ञापन कुकी सक्रिय नहीं करती।</p><div class="mt-8 space-y-4"><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">आवश्यक कुकी</h2><p class="text-sm text-[#596158]">साइट के मूल व्यवहार और आपकी कुकी पसंद याद रखने के लिए।</p></div><span class="rounded-full bg-[#e7efe9] px-3 py-1 text-xs font-bold text-leaf">हमेशा सक्रिय</span></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">विश्लेषण कुकी · Google Analytics</h2><p class="text-sm text-[#596158]">समेकित उपयोग डेटा से साइट सुधारने में मदद मिलती है।</p></div><label class="flex items-center gap-2"><input id="analytics" type="checkbox" class="h-5 w-5"/><span class="text-sm font-bold">सक्रिय</span></label></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">पसंद कुकी</h2><p class="text-sm text-[#596158]">भविष्य में थीम जैसी गैर-आवश्यक UI पसंद सुरक्षित करने के लिए आरक्षित। अभी आवश्यक नहीं।</p></div><span class="rounded-full bg-[#eee9df] px-3 py-1 text-xs font-bold">निष्क्रिय</span></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">मार्केटिंग / व्यक्तिगत विज्ञापन</h2><p class="text-sm text-[#596158]">यह साइट व्यक्तिगत विज्ञापन कुकी का उपयोग नहीं करती।</p></div><span class="rounded-full bg-[#eee9df] px-3 py-1 text-xs font-bold">बंद</span></div></div><div class="mt-7 flex flex-wrap gap-3"><button id="save" class="rounded-full bg-deep px-5 py-3 font-bold text-white">पसंद सुरक्षित करें</button><button id="reject" class="rounded-full border border-black/15 px-5 py-3 font-bold">गैर-आवश्यक सब अस्वीकार करें</button></div><p id="status" class="mt-4 text-sm font-semibold text-leaf" aria-live="polite"></p><div class="prose mt-10"><h2>सहमति प्रबंधन</h2><p>आप इस पृष्ठ पर किसी भी समय विश्लेषण सहमति बदल सकते हैं। विकल्प ब्राउज़र के स्थानीय स्टोरेज में रखा जाता है। स्टोरेज साफ करने पर चुनाव रीसेट हो सकता है। Google Maps जैसे एम्बेड को लोड करने पर बाहरी प्रदाता अपनी आवश्यक तकनीक लागू कर सकते हैं; ऐसे एम्बेड की शर्तें उस प्रदाता के अधीन हैं।</p></div></div></section>
<script>
const box=document.querySelector('#analytics');const status=document.querySelector('#status');
if(box instanceof HTMLInputElement){box.checked=localStorage.getItem('cookie-analytics')==='yes'}
document.querySelector('#save')?.addEventListener('click',()=>{if(box instanceof HTMLInputElement){localStorage.setItem('cookie-analytics',box.checked?'yes':'no');status.textContent='आपकी पसंद सुरक्षित कर दी गई है।';if(box.checked && typeof window.loadGA==='function') window.loadGA();}});
document.querySelector('#reject')?.addEventListener('click',()=>{localStorage.setItem('cookie-analytics','no');if(box instanceof HTMLInputElement)box.checked=false;status.textContent='गैर-आवश्यक कुकी अस्वीकार कर दी गई हैं।';});
</script>
</Base>
