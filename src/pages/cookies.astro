---
import Base from '../layouts/Base.astro';
import { withSiteName } from '../data/site';
---
<Base title={withSiteName('कुकी सेटिंग')} description="नीलकंठ महादेव मंदिर यात्री मार्गदर्शिका की कुकी प्राथमिकताएँ देखें और बदलें — विश्लेषण की अनुमति दें या वापस लें और ब्राउज़र स्टोरेज की सीमाएँ जानें।" path="/cookies/">
<section class="section"><div class="container max-w-4xl"><p class="eyebrow">नियंत्रण</p><h1 class="mt-3 text-4xl font-black">कुकी सेटिंग</h1><p class="mt-3 text-[#596158]"><strong>अंतिम अद्यतन: 21 अक्टूबर 2026</strong></p><p class="mt-5 text-[#596158]">हम कुकी और स्थानीय स्टोरेज जैसी तकनीकों का सीमित उपयोग करते हैं। आवश्यक सेटिंग साइट की मूल कार्यक्षमता के लिए होती है; Google Analytics आपकी सहमति से सक्रिय होता है। यह स्वतंत्र गैर-लाभकारी साइट वर्तमान में निजीकरण-आधारित विज्ञापन कुकी सक्रिय नहीं करती।</p><div class="mt-8 space-y-4"><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">आवश्यक कुकी</h2><p class="text-sm text-[#596158]">साइट के मूल व्यवहार और आपकी कुकी पसंद याद रखने के लिए।</p></div><span class="rounded-full bg-[#e7efe9] px-3 py-1 text-xs font-bold text-leaf">हमेशा सक्रिय</span></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">विश्लेषण कुकी · Google Analytics</h2><p class="text-sm text-[#596158]">समेकित उपयोग डेटा से साइट सुधारने में मदद मिलती है।</p></div><label class="flex items-center gap-2"><input id="analytics" type="checkbox" class="h-5 w-5"/><span class="text-sm font-bold">सक्रिय</span></label></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">पसंद कुकी</h2><p class="text-sm text-[#596158]">भविष्य में थीम जैसी गैर-आवश्यक UI पसंद सुरक्षित करने के लिए आरक्षित। अभी आवश्यक नहीं।</p></div><span class="rounded-full bg-[#eee9df] px-3 py-1 text-xs font-bold">निष्क्रिय</span></div><div class="card flex items-start justify-between gap-4 p-5"><div><h2 class="font-black">मार्केटिंग / व्यक्तिगत विज्ञापन</h2><p class="text-sm text-[#596158]">यह साइट व्यक्तिगत विज्ञापन कुकी का उपयोग नहीं करती।</p></div><span class="rounded-full bg-[#eee9df] px-3 py-1 text-xs font-bold">बंद</span></div></div><div class="mt-7 flex flex-wrap gap-3"><button id="save" class="rounded-full bg-deep px-5 py-3 font-bold text-white">पसंद सुरक्षित करें</button><button id="reject" class="rounded-full border border-black/15 px-5 py-3 font-bold">Google Analytics अस्वीकार करें</button></div><p id="status" class="mt-4 text-sm font-semibold text-leaf" aria-live="polite"></p><div class="prose mt-10"><h2>होस्टिंग की अलग माप-व्यवस्था</h2><p>यहाँ का विश्लेषण विकल्प केवल Google Analytics के लिए है। होस्टिंग परत Cloudflare Web Analytics का स्क्रिप्ट स्वतंत्र रूप से जोड़ सकती है, जो पृष्ठ लोड प्रदर्शन और समय के माप लेता है। Google Analytics को अस्वीकार करने से यह होस्टिंग विश्लेषण बंद नहीं होता। Cloudflare के <a href="https://developers.cloudflare.com/web-analytics/data-metrics/data-origin-and-collection/" target="_blank" rel="noopener noreferrer">डेटा संग्रह विवरण</a>, <a href="https://developers.cloudflare.com/web-analytics/faq/" target="_blank" rel="noopener noreferrer">सामान्य प्रश्न</a> और हमारी <a href="/privacy/">गोपनीयता नीति</a> देखें।</p><h2>सहमति प्रबंधन</h2><p>आप इस पृष्ठ पर किसी भी समय Google Analytics की सहमति बदल सकते हैं। विकल्प ब्राउज़र के स्थानीय स्टोरेज में रखा जाता है। स्टोरेज साफ करने पर चुनाव रीसेट हो सकता है। ब्राउज़र स्टोरेज विफल हो तो Google Analytics वर्तमान पृष्ठ पर बंद रहता है; नया टैब या रीफ़्रेश पुरानी सुरक्षित पसंद पढ़ सकता है। स्थिति संदेश जाँचें। Google Maps जैसे एम्बेड को लोड करने पर बाहरी प्रदाता अपनी आवश्यक तकनीक लागू कर सकते हैं; ऐसे एम्बेड की शर्तें उस प्रदाता के अधीन हैं।</p></div></div></section>

</Base>
