---
import Base from '../layouts/Base.astro';
---
<Base
  title="ऑफ़लाइन | नीलकंठ महादेव यात्री मार्गदर्शिका"
  description="यह पृष्ठ तब दिखाया जाता है जब इंटरनेट कनेक्शन उपलब्ध नहीं होता। संपर्क/मार्ग जानकारी के लिए कनेक्शन पुनः प्राप्त करें।"
  path="/offline/"
  noindex={true}
>
  <section class="section">
    <div class="container max-w-3xl">
      <p class="eyebrow">ऑफ़लाइन</p>
      <h1 class="mt-3 text-4xl font-black">अभी इंटरनेट कनेक्शन उपलब्ध नहीं है</h1>
      <p class="mt-4 text-[#596158]">
        आपने पहले देखे हुए पृष्ठ कैश से लोड हो सकते हैं। मानचित्र, ताज़ा दर्शन समय और बाहरी
        संदर्भों के लिए कृपया कनेक्शन पुनः सक्रिय करें।
      </p>
      <p class="mt-6"><a class="rounded-full bg-deep px-5 py-3 font-bold text-white" href="/">मुख्य पृष्ठ पर जाएँ</a></p>
    </div>
  </section>
</Base>
