---
import Base from '../layouts/Base.astro';
const place = {
 name:'श्री नीलकंठ महादेव मंदिर', address:'38JR+C7F, कोटद्वार–पौड़ी रोड, पौड़ी गढ़वाल, उत्तराखंड 249304, भारत', lat:30.0811, lng:78.3411,
 rating:4.7, hours:'प्रतिदिन प्रातः 5:00 से सायं 6:00 तक (यात्रा से पहले सत्यापित करें)'
};
const siteUrl = Astro.site?.toString();
const touristLd = { '@context':'https://schema.org','@type':['TouristAttraction','HinduTemple'], name:place.name, description:'पौड़ी गढ़वाल में भगवान शिव को समर्पित प्रसिद्ध तीर्थ, जो समुद्र मंथन और नीलकंठ कथा से जुड़ा है।', address:{'@type':'PostalAddress',streetAddress:'38JR+C7F, Kotdwar - Pauri Rd',addressRegion:'Uttarakhand',postalCode:'249304',addressCountry:'IN'}, geo:{'@type':'GeoCoordinates',latitude:place.lat,longitude:place.lng}, openingHours:'Mo-Su 05:00-18:00', aggregateRating:{'@type':'AggregateRating',ratingValue:'4.7',reviewCount:'41891'}, ...(siteUrl?{url:new URL('/',siteUrl).toString()}: {}) };
const faq = [
 ['मंदिर कहाँ स्थित है?','यह पौड़ी गढ़वाल जिले में ऋषिकेश से सड़क मार्ग द्वारा लगभग 32 किमी दूर, नीलकंठ क्षेत्र में स्थित है।'],
 ['प्रवेश शुल्क कितना है?','सामान्य दर्शन के लिए प्रायः प्रवेश शुल्क नहीं बताया जाता। विशेष पूजा, प्रसाद या निजी सेवाओं के शुल्क अलग हो सकते हैं; मौके पर आधिकारिक व्यवस्था जाँचें।'],
 ['कितना समय रखें?','सामान्य दर्शन के लिए 1–3 घंटे रखें। भीड़, पर्व, सड़क यातायात और पैदल मार्ग के अनुसार अधिक समय लग सकता है।'],
 ['कौन-सा समय बेहतर है?','सुबह का समय अपेक्षाकृत शांत और ठंडा रहता है। सावन, महाशिवरात्रि तथा सप्ताहांत में भीड़ अधिक हो सकती है।'],
 ['क्या वरिष्ठ नागरिकों के लिए आसान है?','अंतिम पहुँच क्षेत्र में ढलान, सीढ़ियाँ और भीड़ हो सकती है। धीमी गति रखें, साथ में पानी रखें और स्थानीय स्थिति देखकर सहायता लें।'],
 ['क्या पार्किंग उपलब्ध है?','मंदिर क्षेत्र के आसपास सीमित/मौसमी पार्किंग व्यवस्था मिल सकती है, पर भीड़ वाले दिनों में क्षमता दबाव में रहती है। निजी वाहन से आने पर समय का अतिरिक्त अंतर रखें।']
];
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Base title="श्री नीलकंठ महादेव मंदिर | स्वतंत्र यात्रा व इतिहास मार्गदर्शिका" description="श्री नीलकंठ महादेव मंदिर के इतिहास, समुद्र मंथन की कथा, दर्शन समय, यात्रा, बस/टैक्सी, पार्किंग, WC, भोजन, ठहराव और आसपास के दर्शनीय स्थलों की निष्पक्ष जानकारी।">
<script type="application/ld+json" set:html={JSON.stringify(touristLd)}></script><script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
<section class="relative overflow-hidden bg-deep text-white"><div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_80%_15%,#d97706_0,transparent_30%),linear-gradient(145deg,#315b46,transparent_55%)]"></div><div class="container relative grid min-h-[680px] items-center gap-10 py-20 lg:grid-cols-[1.1fr_.9fr]"><div><p class="eyebrow !text-[#ffc477]">गढ़वाल हिमालय · शिव तीर्थ</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[1.08] md:text-7xl">जहाँ कथा, पर्वत और श्रद्धा एक साथ मिलते हैं</h1><p class="mt-6 max-w-2xl text-lg text-white/78">श्री नीलकंठ महादेव मंदिर समुद्र मंथन की उस पुराणकथा से जुड़ा है जिसमें शिव ने विष का पान किया और उनका कंठ नीलवर्ण हुआ। मंदिर तीन घाटियों और वनाच्छादित पहाड़ी परिवेश के बीच स्थित एक प्रमुख तीर्थ है।</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-saffron px-6 py-3 font-bold text-white" href="#यात्रा">यात्रा की तैयारी</a><a class="rounded-full border border-white/30 px-6 py-3 font-bold" href="#इतिहास">कथा पढ़ें</a></div><div class="mt-10 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4"><div><b class="text-2xl">4.7/5</b><span class="block text-xs text-white/60">Google रेटिंग*</span></div><div><b class="text-2xl">05–18</b><span class="block text-xs text-white/60">सामान्य समय*</span></div><div><b class="text-2xl">32 किमी</b><span class="block text-xs text-white/60">ऋषिकेश से*</span></div><div><b class="text-2xl">1–3 घंटे</b><span class="block text-xs text-white/60">सुझाया प्रवास</span></div></div><p class="mt-3 text-xs text-white/45">*समय, दूरी और रेटिंग बदल सकते हैं; प्रस्थान से पहले सत्यापित करें।</p></div><figure class="relative"><div class="aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/15 bg-[#24372d] shadow-2xl"><img src="https://upload.wikimedia.org/wikipedia/commons/7/7d/NeelKanth_Mahadev_Temple.JPG" alt="ऋषिकेश के निकट श्री नीलकंठ महादेव मंदिर का रंगीन शिखर" class="h-full w-full object-cover" loading="eager"/></div><figcaption class="mt-3 text-xs text-white/50">वास्तविक ऐतिहासिक फोटो · Wikimedia Commons, सार्वजनिक डोमेन (Rahuldewangan)</figcaption></figure></div></section>
<section class="section"><div class="container"><div class="grid gap-5 md:grid-cols-3"><article class="card p-6"><p class="eyebrow">स्थान</p><h2 class="mt-2 text-2xl font-black">पौड़ी गढ़वाल</h2><p class="mt-2 text-sm text-[#596158]">मंदिर उत्तराखंड के पौड़ी गढ़वाल जिले में नीलकंठ क्षेत्र में है और ऋषिकेश से सड़क एवं पारंपरिक पैदल मार्ग दोनों से पहुँचा जाता है।</p></article><article class="card p-6"><p class="eyebrow">आस्था</p><h2 class="mt-2 text-2xl font-black">नीलकंठ रूप में शिव</h2><p class="mt-2 text-sm text-[#596158]">स्थानीय और पुराणपरंपरा इसे समुद्र मंथन से निकले हलाहल विष और शिव के नीलकंठ रूप से जोड़ती है।</p></article><article class="card p-6"><p class="eyebrow">परिवेश</p><h2 class="mt-2 text-2xl font-black">वन, घाटियाँ, नदियाँ</h2><p class="mt-2 text-sm text-[#596158]">जिला प्रशासन के अनुसार मंदिर विष्णुकूट, ब्रह्मकूट और मणिकूट घाटियों के बीच, मधुमती और पंकजा जलधाराओं के संगम क्षेत्र में है।</p></article></div></div></section>
<section id="इतिहास" class="section bg-[#ede5d6]"><div class="container grid gap-12 lg:grid-cols-[.82fr_1.18fr]"><div><p class="eyebrow">इतिहास व परंपरा</p><h2 class="mt-3 text-4xl font-black">समुद्र मंथन से नीलकंठ तक</h2><p class="mt-5 text-[#586056]">धार्मिक परंपरा के अनुसार देवों और असुरों द्वारा समुद्र मंथन के समय हलाहल विष निकला। सृष्टि की रक्षा के लिए शिव ने उसे ग्रहण किया; विष को कंठ में रोकने से उनका कंठ नीला हुआ और वे “नीलकंठ” कहलाए। पौड़ी गढ़वाल जिला प्रशासन इस स्थल को इसी कथा से जोड़ता है।</p><p class="mt-4 text-[#586056]">कथा को ऐतिहासिक तथ्य की तरह नहीं, बल्कि इस तीर्थ की सांस्कृतिक स्मृति और धार्मिक पहचान के रूप में समझना उचित है। यही भेद एक जिम्मेदार यात्रा-मार्गदर्शिका के लिए महत्वपूर्ण है।</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="card p-6"><b class="text-lg">तीन घाटियाँ</b><p class="mt-2 text-sm text-[#586056]">विष्णुकूट, ब्रह्मकूट और मणिकूट के बीच का प्राकृतिक संदर्भ मंदिर की धार्मिक भूगोल का हिस्सा है।</p></div><div class="card p-6"><b class="text-lg">तीर्थ और वन-पथ</b><p class="mt-2 text-sm text-[#586056]">स्वर्गाश्रम की ओर से लगभग 12 किमी का पारंपरिक ट्रेक घने जंगलों से होकर जाता है; मौसम और स्थानीय सलाह जरूरी है।</p></div><div class="card p-6 sm:col-span-2"><b class="text-lg">त्योहार और भीड़</b><p class="mt-2 text-sm text-[#586056]">महाशिवरात्रि और श्रावण/सावन के दौरान श्रद्धालुओं की संख्या बढ़ती है। धार्मिक अनुशासन, कतार व्यवस्था, पानी और सड़क यातायात के लिए अतिरिक्त समय रखें।</p></div></div></div></section>
<section id="यात्रा" class="section"><div class="container"><p class="eyebrow">विस्तृत परिवहन</p><h2 class="mt-3 text-4xl font-black">कैसे पहुँचें</h2><div class="mt-8 grid gap-5 lg:grid-cols-3"><article class="card p-6"><h3 class="text-xl font-black">✈ हवाई मार्ग</h3><p class="mt-3 text-sm text-[#596158]">जॉली ग्रांट हवाई अड्डा (देहरादून) क्षेत्र का प्रमुख निकटतम हवाई अड्डा है। वहाँ से ऋषिकेश की दिशा में सड़क यात्रा करें और फिर नीलकंठ मार्ग पर आगे बढ़ें। मौसम व यातायात के कारण पहाड़ी सड़क समय बदल सकता है।</p></article><article class="card p-6"><h3 class="text-xl font-black">🚌 बस / साझा वाहन</h3><p class="mt-3 text-sm text-[#596158]">ऋषिकेश, हरिद्वार और क्षेत्रीय बस अड्डों तक नियमित राज्य/निजी बसें मिलती हैं। अंतिम पहाड़ी खंड में साझा जीप/स्थानीय बस की उपलब्धता मौसम व मांग पर निर्भर हो सकती है; वापसी का साधन पहले स्पष्ट करें।</p></article><article class="card p-6"><h3 class="text-xl font-black">🚕 टैक्सी / निजी वाहन</h3><p class="mt-3 text-sm text-[#596158]">ऋषिकेश से टैक्सी सामान्य विकल्प है। सड़क में मोड़, ढलान और तीर्थ-मौसम में जाम संभव है। रात, भारी वर्षा या भूस्खलन चेतावनी के समय अनावश्यक यात्रा से बचें।</p></article></div><div class="mt-5 card p-6"><h3 class="font-black">रेल से</h3><p class="mt-2 text-sm text-[#596158]">ऋषिकेश, हरिद्वार और कोटद्वार क्षेत्रीय रेल पहुँच के प्रमुख बिंदु हैं। मंदिर तक अंतिम यात्रा सड़क/स्थानीय वाहन से पूरी होती है। जिला प्रशासन पौड़ी जिले के लिए कोटद्वार और ऋषिकेश रेलहेड का उल्लेख करता है।</p></div></div></section>
<section id="सुविधाएँ" class="section bg-deep text-white"><div class="container"><p class="eyebrow !text-[#ffc477]">यात्री उपयोगी जानकारी</p><h2 class="mt-3 text-4xl font-black">दर्शन से पहले क्या जानें</h2><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{[
['🚻','WC / स्वच्छता','मुख्य तीर्थ क्षेत्र में सार्वजनिक/सामुदायिक शौचालय मिल सकते हैं, पर भीड़ में स्थिति बदलती है। टिश्यू, सैनिटाइज़र और छोटा कचरा बैग साथ रखें।'],
['🅿','पार्किंग','निकटवर्ती पार्किंग सीमित हो सकती है। सावन और पर्वों में वाहन दबाव बढ़ता है; ड्रॉप-पॉइंट और वापसी समय पहले तय करें।'],
['🍲','भोजन व पानी','धार्मिक क्षेत्र में सामान्य शाकाहारी भोजन, चाय, पैक्ड पानी और प्रसाद प्रकार उपलब्ध होते हैं। स्वच्छता देखकर चुनें; किसी विशिष्ट दुकान की सिफारिश नहीं।'],
['🛏','ठहराव','धर्मशाला, साधारण गेस्टहाउस, होमस्टे और वन/सिंचाई विश्रामगृह जैसे विकल्प क्षेत्र में मिल सकते हैं। त्योहार में अग्रिम योजना रखें।'],
['🛒','दैनिक जरूरतें','यात्रा मार्ग पर छोटे सामान्य स्टोर, दवा/पेयजल/पूजा-सामग्री श्रेणी की दुकानें मिल सकती हैं। विशिष्ट ब्रांड या व्यापारी की अनुशंसा नहीं की जाती।'],
['⛽','ईंधन / चार्जिंग','पहाड़ी खंड में ईंधन और EV चार्जिंग की उपलब्धता शहरी क्षेत्रों से कम हो सकती है। ऋषिकेश/मुख्य कस्बे से निकलने से पहले ईंधन और चार्ज पर्याप्त रखें।'],
['♿','सुगम्यता','ढलान, सीढ़ियाँ और भीड़ गतिशीलता में कठिनाई पैदा कर सकते हैं। व्हीलचेयर-उपयुक्त सतत मार्ग मानकर न चलें; स्थल पर सहायता की स्थिति पूछें।'],
['📶','मोबाइल / नकदी','घाटियों में नेटवर्क अस्थिर हो सकता है। छोटी नकदी, ऑफलाइन नक्शा और जरूरी नंबर लिखित रूप में रखना उपयोगी है।']
].map(([icon,t,d])=><article class="rounded-2xl border border-white/10 bg-white/6 p-5"><span class="text-2xl">{icon}</span><h3 class="mt-3 font-black">{t}</h3><p class="mt-2 text-sm text-white/65">{d}</p></article>)}</div></div></section>
<section class="section"><div class="container grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">समय व खर्च</p><h2 class="mt-3 text-3xl font-black">दर्शन योजना</h2><div class="mt-6 space-y-4"><div class="card p-5"><b>प्रवेश / दर्शन</b><p class="text-sm text-[#596158]">सामान्य प्रवेश के लिए शुल्क आम तौर पर नहीं बताया जाता। विशेष पूजा, दान, प्रसाद, परिवहन या पार्किंग का खर्च अलग हो सकता है।</p></div><div class="card p-5"><b>श्रेष्ठ समय</b><p class="text-sm text-[#596158]">सुबह जल्दी, विशेषकर साधारण कार्यदिवस, अपेक्षाकृत शांत हो सकते हैं। मानसून में सड़क/भूस्खलन जोखिम और सावन में तीर्थ-भीड़ दोनों पर ध्यान दें।</p></div><div class="card p-5"><b>सुझाया ठहराव</b><p class="text-sm text-[#596158]">दर्शन और परिसर के लिए 1–3 घंटे; ऋषिकेश से आने-जाने सहित आधा दिन या अधिक रखना व्यावहारिक है।</p></div></div></div><div><p class="eyebrow">आसपास क्या देखें</p><h2 class="mt-3 text-3xl font-black">धार्मिक व प्राकृतिक संदर्भ</h2><div class="mt-6 card p-6"><p class="text-sm text-[#596158]">किसी विशिष्ट व्यावसायिक टूर या व्यापारी का प्रचार किए बिना, यात्री आसपास इन प्रकार के अनुभवों पर विचार कर सकते हैं:</p><ul class="mt-4 space-y-3 text-sm text-[#596158]"><li>• ऋषिकेश के घाट, आश्रम और गंगा तट के सार्वजनिक धार्मिक क्षेत्र</li><li>• स्वर्गाश्रम की ओर पारंपरिक वन-पैदल मार्ग, केवल मौसम और स्थानीय सलाह अनुकूल होने पर</li><li>• राजाजी परिक्षेत्र के प्राकृतिक दृश्य—केवल अधिकृत प्रवेश नियमों के अनुसार</li><li>• पौड़ी गढ़वाल के अन्य सार्वजनिक रूप से सूचीबद्ध शिव/देवी मंदिर और दृश्य-बिंदु</li></ul></div><div class="mt-4 card p-6"><h3 class="font-black">स्थानीय भोजन</h3><p class="mt-2 text-sm text-[#596158]">गढ़वाली भोजन की श्रेणियों में मंडुवा/रागी रोटी, दाल, स्थानीय साग, दही-आधारित व्यंजन और सरल पहाड़ी भोजन मिल सकता है। तटस्थता बनाए रखने के लिए यहाँ किसी विशिष्ट रेस्तरां या दुकान का नाम नहीं दिया गया है।</p></div></div></div></section>
<section id="मानचित्र" class="section bg-[#ede5d6]"><div class="container"><p class="eyebrow">स्थान</p><h2 class="mt-3 text-4xl font-black">Google मानचित्र</h2><p class="mt-3 max-w-3xl text-[#586056]">एम्बेड में भाषा/क्षेत्र को हिन्दी/भारत के अनुरूप किया गया है। मार्ग और यातायात के लिए यात्रा के समय लाइव मानचित्र देखें।</p><div class="mt-7 overflow-hidden rounded-[1.5rem] border border-black/10 bg-white shadow-xl"><iframe title="श्री नीलकंठ महादेव मंदिर का Google मानचित्र" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6149.69039500682!2d78.33810007726768!3d30.081073574905236!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390914348dccceb9%3A0x1c2f4c719a505597!2sShree%20Neelkanth%20Mahadev%20Temple!5e1!3m2!1shi!2sin!4v1787621823746!5m2!1shi!2sin" width="100%" height="520" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><p class="mt-4 text-sm font-semibold">पता: {place.address}</p></div></section>
<section id="सवाल" class="section"><div class="container"><p class="eyebrow">FAQ</p><h2 class="mt-3 text-4xl font-black">अक्सर पूछे जाने वाले सवाल</h2><div class="mt-7 grid gap-4 md:grid-cols-2">{faq.map(([q,a])=><details class="card p-5"><summary class="cursor-pointer font-black">{q}</summary><p class="mt-3 text-sm text-[#596158]">{a}</p></details>)}</div><div class="mt-10 rounded-2xl border border-amber-800/20 bg-amber-50 p-5 text-sm text-amber-950"><b>जिम्मेदार यात्रा नोट:</b> धार्मिक परंपराओं का सम्मान करें, कतार न तोड़ें, प्लास्टिक/कचरा न फैलाएँ, वन क्षेत्र में शोर न करें और किसी भी मौसम/सड़क चेतावनी को प्राथमिकता दें।</div></div></section>
