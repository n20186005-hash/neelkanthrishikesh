---
import Base from '../layouts/Base.astro';
import SourcesSection from '../components/SourcesSection.astro';
import WeatherSection from '../components/WeatherSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import VisitorResponsibility from '../components/VisitorResponsibility.astro';
import {
  ADDRESS_HI, ATTRACTION_FULL_NAME, ATTRACTION_FULL_NAME_HI, ATTRACTION_SHORT_NAME,
  CITY_NAME, CITY_NAME_HI, COUNTRY_NAME, COUNTRY_NAME_HI, DISTANCE_FROM_RISHIKESH_KM, DISTRICT_NAME_HI, GOVT_TOURISM_URL,
  LATITUDE, LONGITUDE, LOCALITY_NAME_HI, MAPS_SHARE_URL, NEARBY_LANDMARK_1, NEARBY_LANDMARK_2,
  OPENING_HOURS_HI, PLUS_CODE, POSTAL_CODE, RATING_VALUE, REVIEW_COUNT, STATE_PROVINCE_HI
} from '../data/site';
import { attractionSchema, breadcrumbSchema, faqSchema, webSiteSchema } from '../lib/schema';
const place = {
 name:ATTRACTION_FULL_NAME_HI, address:ADDRESS_HI, lat:LATITUDE, lng:LONGITUDE,
 rating:RATING_VALUE, hours:OPENING_HOURS_HI
};
const faq = [
 [`${ATTRACTION_FULL_NAME} (${ATTRACTION_FULL_NAME_HI}) कहाँ स्थित है?`,`${ATTRACTION_FULL_NAME_HI} ${STATE_PROVINCE_HI} के ${DISTRICT_NAME_HI} जिले में, ${CITY_NAME_HI} से सड़क मार्ग द्वारा लगभग 32 किमी दूर नीलकंठ क्षेत्र में स्थित है। डाक पता: ${ADDRESS_HI}।`],
 [`क्या ${ATTRACTION_SHORT_NAME} में प्रवेश निःशुल्क है?`,`सामान्य दर्शन के लिए ${ATTRACTION_FULL_NAME_HI} में प्रायः प्रवेश शुल्क नहीं बताया जाता; यह एक सार्वजनिक धार्मिक परिसर है। विशेष पूजा, प्रसाद, दान या निजी सेवाओं के शुल्क अलग हो सकते हैं।`],
 ['प्रवेश शुल्क कितना है?','सामान्य दर्शन के लिए प्रायः प्रवेश शुल्क नहीं बताया जाता। विशेष पूजा, प्रसाद या निजी सेवाओं के शुल्क अलग हो सकते हैं; मौके पर आधिकारिक व्यवस्था जाँचें।'],
 ['कितना समय रखें?','सामान्य दर्शन के लिए 1–3 घंटे रखें। भीड़, पर्व, सड़क यातायात और पैदल मार्ग के अनुसार अधिक समय लग सकता है।'],
 ['कौन-सा समय बेहतर है?','सुबह का समय अपेक्षाकृत शांत और ठंडा रहता है। सावन, महाशिवरात्रि तथा सप्ताहांत में भीड़ अधिक हो सकती है।'],
 ['क्या वरिष्ठ नागरिकों के लिए आसान है?','अंतिम पहुँच क्षेत्र में ढलान, सीढ़ियाँ और भीड़ हो सकती है। धीमी गति रखें, साथ में पानी रखें और स्थानीय स्थिति देखकर सहायता लें।'],
 ['क्या पार्किंग उपलब्ध है?','मंदिर क्षेत्र के आसपास सीमित/मौसमी पार्किंग व्यवस्था मिल सकती है, पर भीड़ वाले दिनों में क्षमता दबाव में रहती है। निजी वाहन से आने पर समय का अतिरिक्त अंतर रखें।'],
 [`${CITY_NAME_HI} से ${ATTRACTION_SHORT_NAME} तक पहुँचने का सबसे सामान्य तरीका क्या है?`,'सड़क मार्ग: टैक्सी/निजी वाहन, साझा जीप या स्थानीय बस। ऋषिकेश से लगभग 32 किमी की पहाड़ी सड़क यात्रा, और स्वर्गाश्रम की ओर से पारंपरिक पैदल मार्ग भी उपलब्ध है (केवल अनुकूल मौसम व स्थानीय सलाह पर)।'],
 [`ऋषिकेश से नीलकंठ महादेव मंदिर की दूरी कितनी है?`,`ऋषिकेश से नीलकंठ महादेव मंदिर की दूरी सड़क मार्ग से लगभग ${DISTANCE_FROM_RISHIKESH_KM} किमी है; पहाड़ी सड़क और यातायात के कारण यात्रा में सामान्यतः 1–1.5 घंटे लगते हैं।`],
 ['नीलकंठ महादेव मंदिर की आरती का समय क्या है?','आरती और पूजा के समय पर्व, मौसम और मंदिर व्यवस्था के अनुसार बदलते हैं; सटीक समय यात्रा से पहले परिसर की आधिकारिक सूचना या प्रबंधन से जाँचें।'],
 ['नीलकंठ महादेव मंदिर का इतिहास क्या है?',`${ATTRACTION_FULL_NAME_HI} का इतिहास समुद्र मंथन की कथा से जुड़ा है, जिसमें शिव ने हलाहल विष पीकर सृष्टि की रक्षा की और उनका कंठ नीला हुआ — इसी से 'नीलकंठ' नाम। विस्तृत कथा व महत्व ऊपर 'इतिहास' अनुभाग में देखें।`]
 ];
const attractionLd = attractionSchema();
const faqLd = faqSchema(faq.map(([q, a]) => ({ q, a })));
const breadcrumbLd = breadcrumbSchema();
const websiteLd = webSiteSchema();
const pageTitle = `${ATTRACTION_FULL_NAME_HI} (${ATTRACTION_FULL_NAME}) ${CITY_NAME} — इतिहास (history in Hindi), दर्शन समय, दूरी व यात्रा मार्ग`;
const pageDescription = `${ATTRACTION_FULL_NAME_HI} (${ATTRACTION_FULL_NAME}), ${CITY_NAME} से ${DISTANCE_FROM_RISHIKESH_KM} किमी — समुद्र मंथन कथा, हिंदी इतिहास (history in Hindi), दर्शन समय 5–18, प्रवेश निःशुल्क, कैसे पहुँचें (टैक्सी/बस/पैदल) व FAQ। Neelkanth Mahadev Temple Rishikesh guide: history, timings, distance, entry fee, how to reach.`;
---
<Base title={pageTitle} description={pageDescription}>
<script type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script><script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script><script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script><script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
<section class="relative overflow-hidden bg-deep text-white"><div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_80%_15%,#d97706_0,transparent_30%),linear-gradient(145deg,#315b46,transparent_55%)]"></div><div class="container relative grid min-h-[680px] items-center gap-10 py-20 lg:grid-cols-[1.1fr_.9fr]"><div><p class="eyebrow !text-[#ffc477]">गढ़वाल हिमालय · शिव तीर्थ</p>
<nav aria-label="breadcrumb" class="mt-3 text-sm text-white/65"><ol class="flex flex-wrap items-center gap-2"><li><a class="underline decoration-white/30 underline-offset-4" href="/">मुख्य</a></li><li aria-hidden="true">/</li><li>{COUNTRY_NAME_HI}</li><li aria-hidden="true">/</li><li>{STATE_PROVINCE_HI}</li><li aria-hidden="true">/</li><li>{DISTRICT_NAME_HI}</li><li aria-hidden="true">/</li><li>{CITY_NAME_HI}</li><li aria-hidden="true">/</li><li aria-current="page" class="font-semibold text-white">{ATTRACTION_FULL_NAME_HI}</li></ol></nav>
<h1 class="mt-4 max-w-4xl text-4xl font-black leading-[1.1] md:text-6xl">{ATTRACTION_FULL_NAME_HI} — जहाँ कथा, पर्वत और श्रद्धा एक साथ मिलते हैं</h1>
<p class="mt-3 max-w-3xl text-sm text-[#ffc477]">{ATTRACTION_FULL_NAME} · {CITY_NAME_HI}/{LOCALITY_NAME_HI}, {DISTRICT_NAME_HI}, {STATE_PROVINCE_HI}, {COUNTRY_NAME_HI}</p>
<p class="mt-6 max-w-2xl text-lg text-white/78">श्री नीलकंठ महादेव मंदिर समुद्र मंथन की उस पुराणकथा से जुड़ा है जिसमें शिव ने विष का पान किया और उनका कंठ नीलवर्ण हुआ। मंदिर तीन घाटियों और वनाच्छादित पहाड़ी परिवेश के बीच स्थित एक प्रमुख तीर्थ है।</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-saffron px-6 py-3 font-bold text-white" href="#यात्रा">यात्रा की तैयारी</a><a class="rounded-full border border-white/30 px-6 py-3 font-bold" href="#इतिहास">कथा पढ़ें</a></div><div class="mt-10 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4"><div><b class="text-2xl">{RATING_VALUE}/5</b><span class="block text-xs text-white/60">Google रेटिंग · {REVIEW_COUNT.toLocaleString('en-IN')} समीक्षाएँ*</span></div><div><b class="text-2xl">05–18</b><span class="block text-xs text-white/60">सामान्य समय*</span></div><div><b class="text-2xl">32 किमी</b><span class="block text-xs text-white/60">ऋषिकेश से*</span></div><div><b class="text-2xl">1–3 घंटे</b><span class="block text-xs text-white/60">सुझाया प्रवास</span></div></div><p class="mt-3 text-xs text-white/45">*समय, दूरी और रेटिंग बदल सकते हैं; प्रस्थान से पहले सत्यापित करें।</p></div><figure class="relative"><div class="aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/15 bg-[#24372d] shadow-2xl"><img src="/images/hero.jpg" alt={`${ATTRACTION_FULL_NAME} - Main view in ${CITY_NAME}, ${COUNTRY_NAME}`} width="1280" height="1430" class="h-full w-full object-cover" loading="eager"/></div><figcaption class="mt-3 text-xs text-white/50">वास्तविक ऐतिहासिक फोटो · Wikimedia Commons, सार्वजनिक डोमेन (Rahuldewangan)</figcaption></figure></div></section>
<WeatherSection/>
<section id="परिचय" class="section"><div class="container"><p class="eyebrow">परिचय · About</p><h2 class="mt-3 text-4xl font-black">{ATTRACTION_FULL_NAME_HI} के बारे में — About {ATTRACTION_FULL_NAME}</h2><p class="mt-4 max-w-3xl text-[#596158]">Welcome to <strong>{ATTRACTION_FULL_NAME}</strong>, widely recognized as the central <strong>{ATTRACTION_SHORT_NAME}</strong> of {CITY_NAME}. {ATTRACTION_FULL_NAME_HI} {LOCALITY_NAME_HI}/{CITY_NAME_HI}, {DISTRICT_NAME_HI}, {STATE_PROVINCE_HI}, {COUNTRY_NAME_HI} में स्थित एक प्रमुख शिव तीर्थ है और इस क्षेत्र के यात्रियों के लिए केंद्रीय आकर्षण है। This complete guide covers the Neelkanth Mahadev Temple history in Hindi, darshan timings, distance from Rishikesh (~32 km), entry fee (free general darshan) and how to reach by taxi, bus or the traditional trek.</p><div class="mt-8 grid gap-5 md:grid-cols-3"><article class="card p-6"><p class="eyebrow">स्थान</p><h3 class="mt-2 text-2xl font-black">पौड़ी गढ़वाल</h3><p class="mt-2 text-sm text-[#596158]">मंदिर उत्तराखंड के पौड़ी गढ़वाल जिले में नीलकंठ क्षेत्र में है और ऋषिकेश से सड़क एवं पारंपरिक पैदल मार्ग दोनों से पहुँचा जाता है।</p></article><article class="card p-6"><p class="eyebrow">आस्था</p><h3 class="mt-2 text-2xl font-black">नीलकंठ रूप में शिव</h3><p class="mt-2 text-sm text-[#596158]">स्थानीय और पुराणपरंपरा इसे समुद्र मंथन से निकले हलाहल विष और शिव के नीलकंठ रूप से जोड़ती है।</p></article><article class="card p-6"><p class="eyebrow">परिवेश</p><h3 class="mt-2 text-2xl font-black">वन, घाटियाँ, नदियाँ</h3><p class="mt-2 text-sm text-[#596158]">जिला प्रशासन के अनुसार मंदिर विष्णुकूट, ब्रह्मकूट और मणिकूट घाटियों के बीच, मधुमती और पंकजा जलधाराओं के संगम क्षेत्र में है।</p></article></div></div></section>
<section id="इतिहास" class="section bg-[#ede5d6]"><div class="container grid gap-12 lg:grid-cols-[.82fr_1.18fr]"><div><p class="eyebrow">इतिहास व परंपरा</p><h2 class="mt-3 text-4xl font-black">नीलकंठ महादेव मंदिर का इतिहास व महत्व — समुद्र मंथन से नीलकंठ तक</h2><p class="mt-5 text-[#586056]">धार्मिक परंपरा के अनुसार देवों और असुरों द्वारा समुद्र मंथन के समय हलाहल विष निकला। सृष्टि की रक्षा के लिए शिव ने उसे ग्रहण किया; विष को कंठ में रोकने से उनका कंठ नीला हुआ और वे “नीलकंठ” कहलाए। पौड़ी गढ़वाल जिला प्रशासन इस स्थल को इसी कथा से जोड़ता है।</p><p class="mt-4 text-[#586056]">कथा का विस्तार: मान्यता है कि शिव ने इस विष को निगलने के बाद उसे कंठ में ही रोका (जिससे सृष्टि बची), और शांति पाने के लिए वे इस वनाच्छादित पर्वतीय स्थल पर विश्राम हेतु आए — जहाँ आज मंदिर स्थित है। यही कारण है कि नीलकंठ को “विषपान” और “कंठ-नीलता” का प्रतीक माना जाता है।</p><p class="mt-4 text-[#586056]">ऐतिहासिक दृष्टि: मंदिर परिसर में पंचमुखी (पाँच-मुखी) शिवलिंग और कई छोटे मंदिर/कुंड मिलते हैं, जो सदियों की परंपरा को दर्शाते हैं। कथा को ऐतिहासिक तथ्य की तरह नहीं, बल्कि इस तीर्थ की सांस्कृतिक स्मृति और धार्मिक पहचान के रूप में समझना उचित है। यही भेद एक जिम्मेदार यात्रा-मार्गदर्शिका के लिए महत्वपूर्ण है।</p><p class="mt-4 text-[#586056]">तीर्थ महत्व: नीलकंठ महादेव मंदिर इतिहास केवल पौराणिक नहीं, बल्कि लोक-आस्था और यात्रा-परंपरा का हिस्सा है। स्वर्गाश्रम से लगभग 12 किमी के पारंपरिक वन-पथ से यहाँ पहुँचना स्वयं एक आध्यात्मिक यात्रा (पैदल तीर्थ) माना जाता है, जिसमें श्रद्धालु शिव-नाम का जाप करते हुए जाते हैं। आज भी यह मार्ग सावन और महाशिवरात्रि में हज़ारों श्रद्धालुओं का प्रमुख तीर्थ-मार्ग बनता है।</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="card p-6"><b class="text-lg">समुद्र मंथन कथा</b><p class="mt-2 text-sm text-[#586056]">देव-असुर मंथन में निकला हलाहल विष शिव ने ग्रहण किया; इस कथा से नीलकंठ नाम और इस स्थल का तीर्थ-महत्व जुड़ा है।</p></div><div class="card p-6"><b class="text-lg">पंचमुखी शिवलिंग</b><p class="mt-2 text-sm text-[#586056]">मुख्य शिवलिंग को पाँच मुखों वाला माना जाता है; यह सृष्टि के पाँच तत्वों (भूमि, जल, अग्नि, वायु, आकाश) का प्रतीक माना जाता है।</p></div><div class="card p-6"><b class="text-lg">तीन घाटियाँ</b><p class="mt-2 text-sm text-[#586056]">विष्णुकूट, ब्रह्मकूट और मणिकूट के बीच का प्राकृतिक संदर्भ मंदिर की धार्मिक भूगोल का हिस्सा है।</p></div><div class="card p-6"><b class="text-lg">तीर्थ और वन-पथ</b><p class="mt-2 text-sm text-[#586056]">स्वर्गाश्रम की ओर से लगभग 12 किमी का पारंपरिक ट्रेक घने जंगलों से होकर जाता है; मौसम और स्थानीय सलाह जरूरी है।</p></div><div class="card p-6 sm:col-span-2"><b class="text-lg">त्योहार और भीड़</b><p class="mt-2 text-sm text-[#586056]">महाशिवरात्रि और श्रावण/सावन के दौरान श्रद्धालुओं की संख्या बढ़ती है। धार्मिक अनुशासन, कतार व्यवस्था, पानी और सड़क यातायात के लिए अतिरिक्त समय रखें।</p></div></div></div></section>
<section id="यात्रा" class="section"><div class="container"><p class="eyebrow">विस्तृत परिवहन · Location &amp; How to Visit</p><h2 class="mt-3 text-4xl font-black">{ATTRACTION_FULL_NAME_HI} कैसे पहुँचें — {CITY_NAME_HI} से {ATTRACTION_SHORT_NAME} तक (दूरी {DISTANCE_FROM_RISHIKESH_KM} किमी)</h2><p class="mt-4 max-w-3xl text-[#596158]">ऋषिकेश से नीलकंठ महादेव मंदिर की दूरी सड़क मार्ग से लगभग {DISTANCE_FROM_RISHIKESH_KM} किमी है; पहाड़ी सड़क और मौसम के अनुसार यात्रा में सामान्यतः 1–1.5 घंटे लगते हैं। नीचे तीन सामान्य मार्ग दिए गए हैं।</p><div class="mt-8 grid gap-5 lg:grid-cols-3"><article class="card p-6"><h3 class="text-xl font-black">✈ हवाई मार्ग</h3><p class="mt-3 text-sm text-[#596158]">जॉली ग्रांट हवाई अड्डा (देहरादून) क्षेत्र का प्रमुख निकटतम हवाई अड्डा है। वहाँ से ऋषिकेश की दिशा में सड़क यात्रा करें और फिर नीलकंठ मार्ग पर आगे बढ़ें। मौसम व यातायात के कारण पहाड़ी सड़क समय बदल सकता है।</p></article><article class="card p-6"><h3 class="text-xl font-black">🚌 बस / साझा वाहन</h3><p class="mt-3 text-sm text-[#596158]">ऋषिकेश, हरिद्वार और क्षेत्रीय बस अड्डों तक नियमित राज्य/निजी बसें मिलती हैं। अंतिम पहाड़ी खंड में साझा जीप/स्थानीय बस की उपलब्धता मौसम व मांग पर निर्भर हो सकती है; वापसी का साधन पहले स्पष्ट करें।</p></article><article class="card p-6"><h3 class="text-xl font-black">🚕 टैक्सी / निजी वाहन</h3><p class="mt-3 text-sm text-[#596158]">ऋषिकेश से टैक्सी सामान्य विकल्प है। सड़क में मोड़, ढलान और तीर्थ-मौसम में जाम संभव है। रात, भारी वर्षा या भूस्खलन चेतावनी के समय अनावश्यक यात्रा से बचें।</p></article></div><div class="mt-5 card p-6"><h3 class="font-black">रेल से</h3><p class="mt-2 text-sm text-[#596158]">ऋषिकेश, हरिद्वार और कोटद्वार क्षेत्रीय रेल पहुँच के प्रमुख बिंदु हैं। मंदिर तक अंतिम यात्रा सड़क/स्थानीय वाहन से पूरी होती है। जिला प्रशासन पौड़ी जिले के लिए कोटद्वार और ऋषिकेश रेलहेड का उल्लेख करता है।</p></div><div class="mt-6"><p class="eyebrow">चरणबद्ध मार्ग विवरण</p><h3 class="mt-2 text-2xl font-black">ऋषिकेश से नीलकंठ तक: तीन आम मार्ग</h3><div class="mt-5 grid gap-5 md:grid-cols-2"><div class="card p-6"><h4 class="font-black">✈️ हवाई यात्रा (देहरादून जॉली ग्रांट)</h4><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#596158]"><li>देहरादून (Jolly Grant) हवाई अड्डे उतरें — क्षेत्र का निकटतम प्रमुख हवाई अड्डा।</li><li>वहाँ से ऋषिकेश/रायवाला मार्ग पर टैक्सी या बस से लगभग 1.5–2.5 घंटे की सड़क यात्रा।</li><li>ऋषिकेश से नीलकंठ के लिए टैक्सी/साझा वाहन लें (≈32 किमी पहाड़ी सड़क)।</li></ol></div><div class="card p-6"><h4 class="font-black">🚌 सार्वजनिक बस / साझा वाहन</h4><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#596158]"><li>हरिद्वार या ऋषिकेश बस अड्डे तक पहुँचें (रेल/बस से)।</li><li>ऋषिकेश से नीलकंठ/कोटद्वार मार्ग की नियमित साझा जीप या स्थानीय बस पकड़ें।</li><li>अंतिम खंड में वापसी का साधन पहले तय करें; शाम को वाहन कम मिलते हैं।</li></ol></div><div class="card p-6"><h4 class="font-black">🚕 टैक्सी / निजी वाहन (सीधा)</h4><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#596158]"><li>ऋषिकेश से सीधे टैक्सी बुक करें; यह सबसे लचीला विकल्प है।</li><li>मार्ग: ऋषिकेश → स्वर्गाश्रम → नीलकंठ (≈32 किमी, पहाड़ी मोड़)।</li><li>रात, भारी वर्षा या भूस्खलन चेतावनी में यात्रा टालें; ईंधन/चार्ज पूरा रखें।</li></ol></div><div class="card p-6"><h4 class="font-black">🥾 पारंपरिक पैदल मार्ग</h4><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#596158]"><li>स्वर्गाश्रम (ऋषिकेश) से लगभग 12 किमी का वन-ट्रेक।</li><li>केवल अनुकूल मौसम, दिन के उजाले और स्थानीय सलाह पर करें।</li><li>पानी, उचित जूते और साथी रखें; एकांत खंडों में अकेले न जाएँ।</li></ol></div></div></div></div></section>
