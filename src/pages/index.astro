---
import Base from '../layouts/Base.astro';
import SourcesSection from '../components/SourcesSection.astro';
import WeatherSection from '../components/WeatherSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import VisitorResponsibility from '../components/VisitorResponsibility.astro';
import TopicLinks from '../components/TopicLinks.astro';
import { MAPS_SHARE_URL, MAPS_EMBED_SRC, LATITUDE, LONGITUDE, DISTRICT_ADMIN_URL, COMMONS_IMAGE_URL } from '../data/site';
import { attractionSchema, breadcrumbSchema, faqSchema, webSiteSchema } from '../lib/schema';
const faq = [
 {q:'नीलकंठ महादेव मंदिर ऋषिकेश से कितनी दूर है?',a:'जिला प्रशासन के पुराने विवरण में बैराज होकर 32 किमी और राम झूला होकर 22 किमी बताए गए हैं। यह मार्ग-दूरी का संदर्भ है; आज के वाहन मार्ग और खुले रास्ते स्थानीय सूचना से जाँचें।'},
 {q:'मंदिर के दर्शन का समय क्या है?',a:'20 अक्टूबर 2026 को Google Maps लिस्टिंग में सोमवार से रविवार 05:00–18:00 दिखा। यह तृतीय-पक्ष स्नैपशॉट है; आरती, पर्व और वास्तविक प्रवेश का समय स्थानीय व्यवस्था से फिर जाँचें।'},
 {q:'क्या प्रवेश निःशुल्क है?',a:'सामान्य प्रवेश या विशेष पूजा का वर्तमान आधिकारिक शुल्क स्रोत नहीं मिला। किसी निश्चित मुफ्त प्रवेश का भरोसा करने के बजाय मंदिर की सूचना जाँचें; दान, प्रसाद और निजी सेवाएँ अलग हो सकती हैं।'},
 {q:'नीलकंठ महादेव मंदिर कहाँ है?',a:'पौड़ी गढ़वाल जिला प्रशासन इसे ऋषिकेश के निकट नीलकंठ तीर्थ के रूप में बताता है। Maps का प्रदर्शित पता कोटद्वार–पौड़ी रोड, कोटद्वार है; नीचे मूल पता और सत्यापित पिन दिए हैं। यात्रा के लिए सही स्थल-पिन मिलाएँ।'},
 {q:'पैदल मार्ग कितना लंबा है?',a:'जिला प्रशासन के पुराने विवरण में 12 किमी वन-पैदल मार्ग का उल्लेख है। इसे आज खुला या सुरक्षित होने का प्रमाण न मानें; स्थानीय अनुमति, मौसम और वापसी की व्यवस्था पहले जाँचें।'},
 {q:'क्या पार्किंग और शौचालय मिलेंगे?',a:'इन सुविधाओं की वर्तमान उपलब्धता, शुल्क और पहुँच की पुष्टि नहीं हुई है। मौके की व्यवस्था पूछें और वैकल्पिक योजना रखें।'},
 {q:'कितना समय रखें?',a:'दर्शन के लिए 1–3 घंटे एक निजी योजना का अनुमान है, कतार का वादा नहीं। सड़क और पर्व-भीड़ के लिए अतिरिक्त समय जोड़ें; वापसी का साधन पहले तय करें।'},
 {q:'क्या वरिष्ठ नागरिक या व्हीलचेयर उपयोगकर्ता जा सकते हैं?',a:'बिना सीढ़ी वाला मार्ग और सहायता की वर्तमान पुष्टि नहीं है। अपनी जरूरत बताकर प्रवेश बिंदु, ढलान और सहायता पहले पूछें; केवल वाहन से पहुँच को सुगम प्रवेश न मानें।'}
];
const schemas=[attractionSchema(),breadcrumbSchema(),faqSchema(faq),webSiteSchema()];
const facilities=[
 ['पार्किंग और ड्रॉप-पॉइंट','आज की क्षमता, शुल्क और वाहन प्रतिबंध स्थानीय व्यवस्था से पूछें; इस साइट ने उनकी पुष्टि नहीं की है।'],
 ['शौचालय और पानी','शौचालय की पहुँच और पीने के पानी की उपलब्धता पहले पूछें। अपना पानी और आवश्यक स्वच्छता सामान रखें।'],
 ['भोजन और ठहराव','भोजन, धर्मशाला या विश्रामगृह को उपलब्ध मानकर न निकलें। पुराने जिला विवरण में विश्रामगृह का उल्लेख वर्तमान बुकिंग प्रमाण नहीं है।'],
 ['सुगम्यता','सीढ़ियों, ढलान, कतार और सहायक व्यक्ति की जरूरत पहले समझें। व्हीलचेयर मार्ग की पुष्टि नहीं है।'],
 ['ईंधन, नकदी और नेटवर्क','वापसी का वाहन, जरूरी भुगतान और ऑफलाइन पता पहले तैयार करें; यहाँ किसी ATM, चार्जिंग या नेटवर्क की गारंटी नहीं है।'],
 ['स्वास्थ्य और आपात योजना','अपनी नियमित दवा साथ रखें और स्थानीय सहायता बिंदु पहले पूछें। मौसम पूर्वानुमान को आधिकारिक सुरक्षा चेतावनी न मानें।']
];
---
<Base title="नीलकंठ महादेव मंदिर ऋषिकेश | दर्शन, दूरी और मार्ग" description="नीलकंठ महादेव मंदिर ऋषिकेश की दूरी, मार्ग और दर्शन की तैयारी। दिनांक सहित Maps समय, स्थल-पिन, ऐतिहासिक कथा, मौसम और सुविधाओं की सीमाएँ जानें।">
{schemas.map(schema=><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
<section id="परिचय" class="section bg-deep text-white"><div class="container grid items-center gap-10 lg:grid-cols-[1.15fr_.85fr]"><div><p class="eyebrow !text-[#ffc477]">स्वतंत्र यात्री मार्गदर्शिका · ऋषिकेश के निकट</p><h1 class="mt-4 text-5xl font-black leading-tight">श्री नीलकंठ महादेव मंदिर, ऋषिकेश</h1><p class="mt-4 text-lg text-white/80">Shree Neelkanth Mahadev Temple · श्री नीलकण्ठ महादेव मन्दिर</p><p class="mt-5 text-white/80">भगवान शिव से जुड़ा यह तीर्थ ऋषिकेश की यात्रा में शामिल किया जा सकता है। यहाँ दूरी, सही स्थल-पिन और दर्शन की तैयारी एक साथ देखें; हम मंदिर प्रबंधन या बुकिंग सेवा नहीं हैं।</p><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-saffron px-6 py-3 font-bold text-white" href="#यात्रा">दूरी और मार्ग देखें</a><a class="rounded-full border border-white/30 px-6 py-3 font-bold" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">Maps पर स्थल खोलें</a></div><dl class="hero-facts mt-8 grid grid-cols-2 gap-5"><div><dt class="text-sm text-white/70">बैराज होकर दूरी</dt><dd class="text-2xl font-bold">लगभग 32 किमी*</dd></div><div><dt class="text-sm text-white/70">Maps में प्रदर्शित समय</dt><dd class="text-2xl font-bold">05:00–18:00*</dd></div></dl><p class="mt-4 text-sm text-white/70">*दूरी: पुराना जिला विवरण; समय: Google Maps, 20 अक्टूबर 2026 का स्नैपशॉट। खुले मार्ग और प्रवेश को यात्रा से पहले जाँचें।</p></div><figure><img src="/images/hero.jpg" alt="नीलकंठ महादेव मंदिर का रंगीन शिखर और प्रवेश, 2010 की तस्वीर" width="384" height="429" class="mx-auto w-full max-w-[384px] rounded-3xl" fetchpriority="high"/><figcaption class="mt-4 text-sm text-white/75">ऐतिहासिक फोटो, 23 मार्च 2010 · <a href={COMMONS_IMAGE_URL} class="underline" target="_blank" rel="noopener noreferrer">Rahuldewangan / Wikimedia Commons</a> · सार्वजनिक डोमेन। आज का रूप अलग हो सकता है।</figcaption></figure></div></section>
<section id="इतिहास" class="section"><div class="container prose max-w-4xl"><p class="eyebrow">आस्था और परिचय</p><h2>नीलकंठ नाम और समुद्र मंथन की कथा</h2><p>जिला प्रशासन के परिचय में शिव के विषपान से नीले कंठ की कथा बताई गई है। यह धार्मिक परंपरा है, प्रमाणित ऐतिहासिक घटना का दावा नहीं। उसी परिचय में आसपास की तीन घाटियों का उल्लेख मिलता है।</p><p><a href={DISTRICT_ADMIN_URL} target="_blank" rel="noopener noreferrer" class="underline">जिला प्रशासन का मंदिर-परिचय</a> अंतिम अद्यतन 6 अप्रैल 2018 बताता है। इसका उपयोग सांस्कृतिक और पुराने मार्ग-संदर्भ के लिए किया गया है, आज की सेवाओं या अनुमति के प्रमाण के लिए नहीं।</p></div></section>
<section id="यात्रा" class="section bg-[#ede5d6]"><div class="container"><p class="eyebrow">ऋषिकेश से नीलकंठ की दूरी</p><h2 class="mt-3 text-4xl font-black">कैसे पहुँचें: वाहन मार्ग और पैदल विकल्प</h2><div class="mt-7 grid gap-5 md:grid-cols-2"><article class="card p-6"><h3 class="text-xl font-black">सड़क: 32 किमी और 22 किमी का अंतर</h3><p class="mt-3">पुराने जिला पृष्ठ में ऋषिकेश से बैराज होकर 32 किमी तथा राम झूला होकर 22 किमी दिए हैं। ये अलग मार्गों के संदर्भ हैं। आज कौन-सा रास्ता किस वाहन के लिए खुला है, यह स्थानीय सूचना और लाइव मानचित्र से मिलाएँ।</p><p class="mt-3">निश्चित 1–1.5 घंटे का भरोसा न करें। पहाड़ी सड़क, रुकावट और कतार यात्रा बढ़ा सकती हैं। टैक्सी या निजी वाहन की वापसी, ड्रॉप-पॉइंट और किराया पहले स्पष्ट करें।</p></article><article class="card p-6"><h3 class="text-xl font-black">पैदल: पुराने विवरण में 12 किमी</h3><p class="mt-3">जिला पृष्ठ में वन के बीच 12 किमी पैदल मार्ग का उल्लेख है। वर्तमान खुली स्थिति और अनुमति अलग से जाँचें। अपनी शारीरिक क्षमता, दिन का उजाला, पानी और वापसी योजना देखकर निर्णय लें।</p><p class="mt-3">बारिश, अँधेरे या स्थानीय बंदी की स्थिति में इस पुराने वर्णन को मार्ग-सलाह न मानें।</p></article><article class="card p-6"><h3 class="text-xl font-black">रेल और हवाई यात्रा</h3><p class="mt-3">पहले ऋषिकेश क्षेत्र तक अपनी रेल या हवाई यात्रा तय करें। स्टेशन या हवाई अड्डे से सीधे मंदिर तक पहुँच, किराया और समय ऑपरेटर से पूछें। यहाँ वर्तमान ट्रेन, बस या उड़ान समय-सारणी सत्यापित नहीं है।</p></article><article class="card p-6"><h3 class="text-xl font-black">बस या साझा वाहन</h3><p class="mt-3">नीलकंठ के अंतिम खंड के लिए नियमित बस या साझा जीप की आज की सेवा की पुष्टि नहीं है। प्रस्थान से पहले स्थानीय स्टैंड पर जाने और लौटने की सेवा, अंतिम समय तथा यात्री प्रतिबंध पूछें।</p></article></div></div></section>
<SeasonalStrategy/><Itineraries/>
<section id="सुविधाएँ" class="section"><div class="container"><p class="eyebrow">मौके पर क्या पूछें</p><h2 class="mt-3 text-4xl font-black">दर्शन, शुल्क और सुविधाएँ</h2><p class="mt-4 max-w-3xl">Maps में 20 अक्टूबर 2026 को पूरे सप्ताह 05:00–18:00 दिखा। यह आरती, अंतिम प्रवेश, पर्व व्यवस्था या प्रवेश शुल्क की आधिकारिक पुष्टि नहीं है। सामान्य प्रवेश मुफ्त होने का वर्तमान आधिकारिक प्रमाण भी नहीं मिला; विशेष पूजा, दान और निजी सेवा अलग हो सकती हैं।</p><div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{facilities.map(([title,body])=><article class="card p-6"><h3 class="font-black">{title}</h3><p class="mt-3 text-sm">{body}</p></article>)}</div></div></section>
<section id="मानचित्र" class="section bg-[#ede5d6]"><div class="container"><p class="eyebrow">सही स्थल-पिन</p><h2 class="mt-3 text-4xl font-black">नीलकंठ महादेव मंदिर का पता और Google Maps</h2><p class="mt-4">Maps में मूल प्रदर्शित पता: <span lang="en">38JR+C7F, Kotdwar - Pauri Rd, Kotdwar, Uttarakhand 249304, India</span>। जिला प्रशासन मंदिर को ऋषिकेश के निकट तीर्थ के रूप में बताता है। पता-लेबल को बदलकर नया प्रशासनिक निष्कर्ष नहीं निकाला गया है; दिशा के लिए नीचे दिए स्थल-पिन को मिलाएँ।</p><p class="mt-3">पिन: {LATITUDE}, {LONGITUDE} · Google Maps की तृतीय-पक्ष रेटिंग: 4.7/5, 43,120 समीक्षाएँ (20 अक्टूबर 2026)। यह हमारी अपनी रेटिंग नहीं है। उस जाँच में फोन या आधिकारिक वेबसाइट सूचीबद्ध नहीं थी।</p><div class="mt-6 overflow-hidden rounded-3xl border border-black/10"><iframe title="Shree Neelkanth Mahadev Temple का मानचित्र" src={MAPS_EMBED_SRC} width="100%" height="420" style="border:0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen /></div><p class="mt-4"><a href={MAPS_SHARE_URL} class="font-bold underline" target="_blank" rel="noopener noreferrer">मूल Maps लिस्टिंग और दिशा खोलें</a></p></div></section>
<WeatherSection/>
<section class="section"><div class="container"><p class="eyebrow">ऋषिकेश के साथ योजना</p><h2 class="mt-3 text-3xl font-black">आसपास और स्थानीय भोजन</h2><p class="mt-4 max-w-3xl">ऋषिकेश के घाट या किसी अन्य स्थल को अलग यात्रा मानकर उसकी पहुँच, समय और अनुमति जाँचें। Patna Waterfall और Triveni Ghat की इस पृष्ठ पर वर्तमान जाँच नहीं हुई है; इन्हें मंदिर के ठीक पास या आसानी से सुलभ मानकर कार्यक्रम न बनाएँ।</p><p class="mt-4 max-w-3xl">भोजन और विश्राम का समय अपनी योजना में रखें। किसी विशेष दुकान, भोजन की उपलब्धता, स्वच्छता या खुलने का समय यहाँ प्रमाणित नहीं किया गया है।</p></div></section>
<VisitorResponsibility/>
<TopicLinks locale="hi"/>
<section id="सवाल" class="section"><div class="container"><p class="eyebrow">FAQ</p><h2 class="mt-3 text-4xl font-black">नीलकंठ यात्रा के सामान्य सवाल</h2><div class="mt-7 grid gap-4 md:grid-cols-2">{faq.map(({q,a})=><details class="card p-5"><summary class="cursor-pointer font-black">{q}</summary><p class="mt-3">{a}</p></details>)}</div></div></section>
<SourcesSection/>
</Base>
